# Copy to .env and fill in. .env is git-ignored.

# The shop to track. Only product URLs from this host are accepted.
PRICE_TRACKER_STORE_URL=https://www.example-shop.com
# Optional label for the dashboard and reports (defaults to the domain).
PRICE_TRACKER_STORE_NAME=

# Products to track: comma- or newline-separated URLs.
# Leave empty to use products.txt (one URL per line) instead.
PRICE_TRACKER_PRODUCTS=
# PRICE_TRACKER_PRODUCTS_FILE=products.txt

# Daily collection time and timezone (IANA name, e.g. Europe/Athens).
PRICE_TRACKER_DAILY_TIME=10:00
PRICE_TRACKER_TIMEZONE=UTC

# Optional Telegram report. Leave empty to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Defaults to data/prices.sqlite3 and http://127.0.0.1:8000.
# PRICE_TRACKER_DATABASE=data/prices.sqlite3
# PRICE_TRACKER_HOST=127.0.0.1
# PRICE_TRACKER_PORT=8000
