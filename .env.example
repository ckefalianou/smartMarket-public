# Telegram bot credentials. Keep the real values private in .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configure the store origin and optional display name.
PRICE_TRACKER_STORE_URL=https://www.example.com
PRICE_TRACKER_STORE_NAME=

# Daily collection schedule and optional display context.
PRICE_TRACKER_DAILY_TIME=10:00
PRICE_TRACKER_TIMEZONE=Europe/Athens
PRICE_TRACKER_POSTAL_CODE=

# Optional. Defaults to data/prices.sqlite3 and http://127.0.0.1:8000.
# PRICE_TRACKER_DATABASE=data/prices.sqlite3
# PRICE_TRACKER_HOST=127.0.0.1
# PRICE_TRACKER_PORT=8000
